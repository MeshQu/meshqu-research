{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Signing failures",
        "target": {
          "expr": "rate(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"failure\"}[1m]) > 0",
          "legendFormat": "signing failure",
          "queryType": "range",
          "refId": "Anno-signing"
        },
        "titleFormat": "Signing failure",
        "textFormat": "rate of failure > 0 in last 1m"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Rekor failures",
        "target": {
          "expr": "rate(meshqu_rekor_requests_total{result=\"failure\"}[1m]) > 0",
          "legendFormat": "rekor failure",
          "queryType": "range",
          "refId": "Anno-rekor"
        },
        "titleFormat": "Rekor failure",
        "textFormat": "rate of failure > 0 in last 1m (org-scoped)"
      }
    ]
  },
  "description": "OBS-201 — Experiment-tenant observability for procurement-decisions WP1. Three story rows: (1) what happened in $__range, (2) how the critical-path operations behaved, (3) did decision-to-anchor flow stay intact. Designed to fit a single 1400x1200 render for writeup Appendix B captures.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "What happened — tenant=$tenant, last $__range",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total decisions recorded for the selected tenant over the dashboard time range. Headline volume number — frames the whole panel set.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "—",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "sum(increase(meshqu_decisions_total{tenant=\"$tenant\"}[$__range]))",
          "legendFormat": "Decisions",
          "refId": "A"
        }
      ],
      "title": "Decisions recorded",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Count of successful ed25519 sign() operations + signing ops per decision. **Counts operations, not receipts.** v2 decisions sign twice — once for the v1 envelope inside EvaluationService.evaluate(), again for the v2 envelope in DecisionService.record() — so 'ops per decision' reads ~2.0 (≈200%) for an all-v2 workload. ~1.0 for v1-only. A drop below the expected ratio means signing failed or was disabled mid-run.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "—",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ops per decision" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "sum(increase(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"success\"}[$__range]))",
          "legendFormat": "Sign ops",
          "refId": "A"
        },
        {
          "expr": "100 * sum(increase(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"success\"}[$__range])) / clamp_min(sum(increase(meshqu_decisions_total{tenant=\"$tenant\"}[$__range])), 1)",
          "legendFormat": "ops per decision",
          "refId": "B"
        }
      ],
      "title": "Signing operations",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Count of successful Rekor anchor operations. **Org-scoped (Rekor is shared infrastructure per decision_log)** — includes both per-receipt anchors AND chain-seal anchors from any tenant. In the experiment's single-tenant staging environment this maps cleanly to receipt anchors; in a multi-tenant deployment the count will include cross-tenant Rekor traffic + seal-anchor calls (~1 per chain seal). 'anchors per signed' should sit slightly above 1.0 (≈100%) on staging because seal-anchor adds a small overhead per chain finalisation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "—",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "anchors per signed" },
            "properties": [{ "id": "unit", "value": "percent" }]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "sum(increase(meshqu_rekor_requests_total{result=\"success\"}[$__range]))",
          "legendFormat": "Rekor anchors (org-wide)",
          "refId": "A"
        },
        {
          "expr": "100 * sum(increase(meshqu_rekor_requests_total{result=\"success\"}[$__range])) / clamp_min(sum(increase(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"success\"}[$__range])), 1)",
          "legendFormat": "anchors per signed",
          "refId": "B"
        }
      ],
      "title": "Rekor anchors (org-scoped)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Critical-path error rate as a percentage of decisions: (signing failures + Rekor failures + receipt-write errors + Fastify 5xx) / decisions, over $__range. Headline shows the percentage with the raw error count as secondary. Thresholds: green = 0, yellow = 0.5%, red = 2%. Percentage-based so the bands stay meaningful across run sizes (a 300-record dry run and a 6k-decision experiment look the same). **Mixed scoping**: signing failures, receipt-write errors and Fastify 5xx are tenant-scoped (`tenant=$tenant`); Rekor failures are org-scoped (Rekor metric carries no tenant label per decision_log). On the experiment's single-tenant staging environment these align; in a multi-tenant deployment the Rekor component would include cross-tenant traffic.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "percent",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Errors total" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "100 * (sum(increase(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"failure\"}[$__range])) + sum(increase(meshqu_rekor_requests_total{result=\"failure\"}[$__range])) + sum(increase(meshqu_receipt_write_errors_total{tenant=\"$tenant\"}[$__range])) + sum(increase(meshqu_http_requests_total{tenant=\"$tenant\",status=~\"5..\"}[$__range]))) / clamp_min(sum(increase(meshqu_decisions_total{tenant=\"$tenant\"}[$__range])), 1)",
          "legendFormat": "Error rate",
          "refId": "A"
        },
        {
          "expr": "sum(increase(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"failure\"}[$__range])) + sum(increase(meshqu_rekor_requests_total{result=\"failure\"}[$__range])) + sum(increase(meshqu_receipt_write_errors_total{tenant=\"$tenant\"}[$__range])) + sum(increase(meshqu_http_requests_total{tenant=\"$tenant\",status=~\"5..\"}[$__range]))",
          "legendFormat": "Errors total",
          "refId": "B"
        }
      ],
      "title": "Error rate",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "How did the critical-path operations behave",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Receipt-signing duration percentiles. Log Y-axis because the spread is 4 orders of magnitude (sub-ms typical, multi-second pathological). Red vertical lines = signing-failure events from the dashboard-level annotation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "log", "log": 10 },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(meshqu_signing_duration_seconds_bucket{tenant=\"$tenant\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(meshqu_signing_duration_seconds_bucket{tenant=\"$tenant\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(meshqu_signing_duration_seconds_bucket{tenant=\"$tenant\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Signing latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rekor anchoring latency percentiles. Org-scoped — no tenant filter. Wider Y-axis range than in-process metrics; the 30s top bucket exists to catch cold-cache stalls. Red vertical lines = Rekor failure events from the dashboard-level annotation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "log", "log": 10 },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(meshqu_rekor_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(meshqu_rekor_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(meshqu_rekor_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Rekor latency p50 / p95 / p99 (org-scoped)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "panels": [],
      "title": "Did the decision-to-anchor flow stay intact",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Pipeline integrity: submitted decisions → signed receipts → Rekor anchors. **Mixed scoping**: Submitted and Signed are tenant-scoped (`tenant=$tenant`); Anchored is org-scoped (Rekor metric carries no tenant label per decision_log) and includes both per-receipt and seal-anchor calls. On the experiment's single-tenant staging environment the three lines should track each other and divergence means a stage dropped requests; in a multi-tenant deployment the Anchored line reflects org-wide Rekor activity. Also note: Signed counts *signing operations*, which for v2 decisions double-counts (v1 envelope + v2 envelope) — expect Signed ≈ 2× Submitted on an all-v2 workload. Red dashed overlay = errors summed across the pipeline (signing + Rekor + receipt-write). Annotation overlays mark signing + Rekor failure moments.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Submitted /s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Signed /s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Anchored /s" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Errors /s" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.lineWidth", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "10.4.1",
      "targets": [
        {
          "expr": "sum(rate(meshqu_decisions_total{tenant=\"$tenant\"}[5m]))",
          "legendFormat": "Submitted /s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"success\"}[5m]))",
          "legendFormat": "Signed /s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(meshqu_rekor_requests_total{result=\"success\"}[5m]))",
          "legendFormat": "Anchored /s",
          "refId": "C"
        },
        {
          "expr": "sum(rate(meshqu_signing_requests_total{tenant=\"$tenant\",result=\"failure\"}[5m])) + sum(rate(meshqu_rekor_requests_total{result=\"failure\"}[5m])) + sum(rate(meshqu_receipt_write_errors_total{tenant=\"$tenant\"}[5m]))",
          "legendFormat": "Errors /s",
          "refId": "D"
        }
      ],
      "title": "Decision-to-anchor flow",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["meshqu", "experiment", "procurement-decisions", "obs-201"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allValue": null,
        "current": { "selected": true, "text": "experiment-procurement", "value": "experiment-procurement" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(meshqu_decisions_total, tenant)",
        "hide": 0,
        "includeAll": false,
        "label": "Tenant",
        "multi": false,
        "name": "tenant",
        "options": [],
        "query": { "query": "label_values(meshqu_decisions_total, tenant)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Experiment Tenant Observability",
  "uid": "experiment-tenant-observability",
  "version": 1,
  "weekStart": ""
}
